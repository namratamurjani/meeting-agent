# ---- Database (SQLite, zero-config) ----
DATABASE_URL="file:./dev.db"

# ---- App ----
APP_URL="http://localhost:3000"
# Set to "true" to run node-cron jobs inside the dev server (hourly deadline check, Monday 9am digest)
ENABLE_CRON="false"
# Optional: protects /api/cron/* endpoints (leave blank for local demo)
CRON_SECRET=""

# ---- LLM provider: mock | anthropic | openai ----
# "mock" needs no key and returns deterministic extraction (best for offline demos).
# If anthropic/openai is selected but its key is blank, the app falls back to mock automatically.
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ---- Task tracker: simulated | trello | webhook ----
# Blank Trello keys => simulated tracker (fake card URLs + logged payloads).
TRACKER_PROVIDER="simulated"
TRELLO_API_KEY=""
TRELLO_TOKEN=""
TRELLO_LIST_ID=""
TRACKER_WEBHOOK_URL=""   # Zapier / Make / n8n catch-hook URL

# ---- Notifications (all optional; blank => simulated + logged) ----
NOTIFY_SLACK_WEBHOOK_URL=""
NOTIFY_DISCORD_WEBHOOK_URL=""
RESEND_API_KEY=""
EMAIL_FROM="Meeting Agent <onboarding@resend.dev>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
